---
// src/pages/lecon/[packId].astro
import { getMotsForPack } from "../../../js/backend.js"; // Import depuis VOTRE fichier existant

export const prerender = false;

const { packId } = Astro.params;
let mots = [];

try {
    // Appel de votre fonction existante dans backend.js
    mots = await getMotsForPack(packId);
} catch (error) {
    console.error("Erreur lors de la récupération des mots:", error);
    mots = [];
}

// Fonction de mélange (Fisher-Yates) pour aléatoire
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
        />
        <title>Leçon Mobile</title>
        <style>
            /* Tailwind CSS v4 */
            @import "tailwindcss";

            /* Optimisations spécifiques Mobile */
            body {
                touch-action: manipulation; /* Évite le zoom au double-tap */
                overscroll-behavior: none; /* Empêche le refresh par swipe */
                user-select: none; /* Empêche la sélection de texte accidentelle */
            }
            video {
                width: 100%;
                height: auto;
                aspect-ratio: 9/16; /* Format vertical */
                object-fit: cover;
                background: #000;
                border-radius: 0.75rem; /* rounded-xl */
                box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            }
            .btn-option {
                @apply w-full p-4 mb-3 text-lg font-semibold rounded-xl border-2 border-slate-200 bg-white active:scale-95 transition-transform duration-100 text-slate-800 shadow-sm;
            }
            .btn-option.correct {
                @apply border-green-500 bg-green-100 text-green-800 !important;
            }
            .btn-option.wrong {
                @apply border-red-500 bg-red-100 text-red-800 opacity-70 !important;
            }
            /* Grille pour les vidéos */
            .video-grid {
                @apply w-full grid grid-cols-2 gap-3;
            }
            .video-btn {
                @apply aspect-9/16 bg-slate-200 rounded-xl overflow-hidden relative active:scale-95 transition-transform border-2 border-transparent;
            }
            .video-btn.correct {
                @apply border-green-500;
            }
            .video-btn.wrong {
                @apply border-red-500 opacity-70;
            }
        </style>
    </head>
    <body
        class="bg-slate-50 text-slate-900 font-sans h-screen flex flex-col overflow-hidden"
    >
        <!-- Header -->
        <header class="p-4 bg-white shadow-sm z-10 flex-none">
            <h1 class="text-xl font-bold text-center truncate">
                Pack: {packId}
            </h1>
            <div
                class="flex justify-between mt-2 text-sm text-slate-500 font-medium"
            >
                <span id="progress-text">Chargement...</span>
                <span id="score-text">Score: 0</span>
            </div>
            <div
                class="w-full bg-slate-200 h-2.5 mt-2 rounded-full overflow-hidden"
            >
                <div
                    id="progress-bar"
                    class="h-full bg-blue-600 w-0 transition-all duration-300"
                >
                </div>
            </div>
        </header>

        <!-- Zone de Jeu -->
        <main
            class="flex-1 overflow-y-auto p-4 flex flex-col items-center justify-start relative w-full"
        >
            <!-- Conteneur dynamique -->
            <div
                id="game-container"
                class="w-full max-w-md flex flex-col items-center pb-10"
            >
                <!-- Le contenu est injecté par JS -->
                <div class="text-center text-slate-400 mt-10">
                    Chargement de la leçon...
                </div>
            </div>
        </main>

        <script>
            const allMots = JSON.parse("---JSON.stringify(mots)---");

            let currentIndex = 0;
            let score = 0;
            let isAnswering = false;

            const container = document.getElementById("game-container");
            const progressBar = document.getElementById("progress-bar");
            const progressText = document.getElementById("progress-text");
            const scoreText = document.getElementById("score-text");

            function handleChoice(
                element: HTMLButtonElement | HTMLInputElement,
                isCorrect: boolean,
                isVideoBtn: boolean | null,
                submitBtn = null,
            ) {
                if (isAnswering) return;
                isAnswering = true;

                if (!element) return;

                if (isCorrect) {
                    if (isVideoBtn === true) {
                        element.classList.add("correct");
                    } else if (submitBtn) {
                        // Mode écriture : on style l'input et le bouton
                        element.classList.add("correct");
                        submitBtn.textContent = "Correct !";
                        submitBtn.classList.remove(
                            "bg-blue-600",
                            "active:bg-blue-700",
                        );
                        submitBtn.classList.add("bg-green-600");
                    } else {
                        // Mode QCM texte
                        element.classList.add("correct");
                    }
                    score += 10;
                } else {
                    if (isVideoBtn === true) {
                        element.classList.add("wrong");
                    } else if (submitBtn) {
                        element.classList.add("wrong");
                        submitBtn.textContent = "Erreur";
                        submitBtn.classList.remove(
                            "bg-blue-600",
                            "active:bg-blue-700",
                        );
                        submitBtn.classList.add("bg-red-600");
                    } else {
                        element.classList.add("wrong");
                    }
                }

                // Mise à jour du score à l'écran
                if (scoreText) {
                    scoreText.textContent = `Score: ${score}`;
                }

                // Passage à la question suivante après un délai
                setTimeout(() => {
                    currentIndex++;
                    renderLesson();
                }, 1500);
            }

            // ============================================================
            // 3. AUTRES FONCTIONS UTILITAIRES ET DE RENDU
            // ============================================================

            function updateProgress() {
                if (!progressBar || !progressText || !scoreText) return;
                if (!allMots || allMots.length === 0) return;

                const pct = (currentIndex / allMots.length) * 100;
                progressBar.style.width = `${pct}%`;
                progressText.textContent = `Mot ${currentIndex + 1}/${allMots.length}`;
                scoreText.textContent = `Score: ${score}`;
            }

            function shuffleArray(array) {
                return array.sort(() => Math.random() - 0.5);
            }

            function getLessonType(index) {
                return index % 3; // 0: Vidéo->Mot, 1: Mot->Vidéo, 2: Vidéo->Écriture
            }

            function renderLesson() {
                if (!container) {
                    console.error(
                        "Erreur : Le conteneur de jeu est introuvable.",
                    );
                    return;
                }

                if (!allMots || currentIndex >= allMots.length) {
                    renderEndScreen();
                    return;
                }

                isAnswering = false;
                container.innerHTML = "";
                updateProgress();

                const currentData = allMots[currentIndex];
                const type = getLessonType(currentIndex);

                // Préparation des distracteurs (fausses réponses)
                const otherMots = allMots.filter(
                    (m) => m.id !== currentData.id,
                );
                const distracteurs = shuffleArray(otherMots).slice(0, 3);
                const options = shuffleArray([currentData, ...distracteurs]);

                if (type === 0) {
                    renderVideoToWord(currentData, options);
                } else if (type === 1) {
                    renderWordToVideo(currentData, options);
                } else {
                    renderVideoToWrite(currentData);
                }
            }

            // TYPE 1 : Vidéo -> Choisir le bon mot
            function renderVideoToWord(correct, options) {
                if (!container) return;

                const videoEl = document.createElement("video");
                videoEl.src = correct.urlVideo || correct.video_url;
                videoEl.autoplay = true;
                videoEl.loop = true;
                videoEl.muted = false;
                videoEl.playsInline = true;
                videoEl.className = "mb-6 shadow-xl";

                videoEl.onerror = () => {
                    videoEl.style.display = "none";
                    const errorDiv = document.createElement("div");
                    errorDiv.textContent = "Erreur vidéo";
                    errorDiv.className = "text-red-500 text-center p-4";
                    if (container) container.prepend(errorDiv);
                };

                const grid = document.createElement("div");
                grid.className = "w-full";

                options.forEach((opt) => {
                    const btn = document.createElement("button");
                    btn.textContent = opt.mot || opt.word;
                    btn.className = "btn-option";
                    // 4ème argument = null car pas de bouton de validation dédié
                    btn.onclick = () =>
                        handleChoice(btn, opt.id === correct.id, null, null);
                    grid.appendChild(btn);
                });

                container.appendChild(videoEl);
                container.appendChild(grid);
            }

            // TYPE 2 : Mot -> Choisir la bonne vidéo
            function renderWordToVideo(correct, options) {
                if (!container) return;

                const title = document.createElement("h2");
                title.textContent = correct.mot || correct.word;
                title.className =
                    "text-3xl font-bold mb-8 text-center text-slate-800";

                const grid = document.createElement("div");
                grid.className = "video-grid";

                options.forEach((opt) => {
                    const btn = document.createElement("button");
                    btn.className = "video-btn";

                    const vid = document.createElement("video");
                    vid.src = opt.urlVideo || opt.video_url;
                    vid.className =
                        "w-full h-full object-cover pointer-events-none";
                    vid.muted = true;
                    vid.loop = true;
                    vid.playsInline = true;
                    vid.preload = "metadata";

                    btn.appendChild(vid);
                    // 4ème argument = null car pas de bouton de validation dédié
                    btn.onclick = () =>
                        handleChoice(btn, opt.id === correct.id, true, null);
                    grid.appendChild(btn);
                });

                container.appendChild(title);
                container.appendChild(grid);
            }

            // TYPE 3 : Vidéo -> Écrire le mot
            function renderVideoToWrite(correct) {
                if (!container) return;

                const videoEl = document.createElement("video");
                videoEl.src = correct.urlVideo || correct.video_url;
                videoEl.autoplay = true;
                videoEl.loop = true;
                videoEl.playsInline = true;
                videoEl.className = "mb-6 shadow-xl w-3/4";

                const inputWrapper = document.createElement("div");
                inputWrapper.className = "w-full flex flex-col gap-4";

                const input = document.createElement("input");
                input.type = "text";
                input.placeholder = "Écrivez le mot...";
                input.className =
                    "w-full p-4 text-xl border-2 border-slate-300 rounded-xl focus:border-blue-500 outline-none text-center uppercase bg-white shadow-sm";
                input.autocomplete = "off";
                input.autocapitalize = "none";
                input.spellcheck = false; // Booléen, pas une chaîne

                const submitBtn = document.createElement("button");
                submitBtn.textContent = "Valider";
                submitBtn.className =
                    "w-full bg-blue-600 text-white font-bold py-4 rounded-xl active:bg-blue-700 shadow-lg active:scale-95 transition-transform";

                const checkAnswer = () => {
                    if (isAnswering) return;
                    const val = input.value.trim().toLowerCase();
                    const correctVal = (
                        correct.mot ||
                        correct.word ||
                        ""
                    ).toLowerCase();
                    const isCorrect = val === correctVal && val !== "";

                    // ICI : On passe bien 'submitBtn' (HTMLButtonElement) comme 4ème argument
                    handleChoice(input, isCorrect, false, submitBtn);
                };

                submitBtn.onclick = checkAnswer;

                input.addEventListener("keypress", (e) => {
                    if (e.key === "Enter") checkAnswer();
                });

                inputWrapper.appendChild(input);
                inputWrapper.appendChild(submitBtn);

                container.appendChild(videoEl);
                container.appendChild(inputWrapper);

                // Focus auto et scroll pour le clavier mobile
                setTimeout(() => {
                    input.focus();
                    input.scrollIntoView({
                        behavior: "smooth",
                        block: "center",
                    });
                }, 300);
            }

            // ÉCRAN DE FIN
            function renderEndScreen() {
                if (!container) return;

                const maxScore = (allMots ? allMots.length : 0) * 10;
                const packId = window.location.pathname.split("/").pop(); // Récupère l'ID depuis l'URL si Astro.params n'est pas dispo ici

                container.innerHTML = `
      <div class="text-center w-full animate-in fade-in zoom-in duration-500">
        <div class="text-6xl mb-4">🎉</div>
        <h2 class="text-3xl font-bold mb-2 text-slate-800">Leçon Terminée !</h2>
        <p class="text-slate-500 mb-6">Pack: ${packId}</p>
        
        <div class="bg-white p-6 rounded-2xl shadow-lg mb-8 border border-slate-100">
          <p class="text-sm text-slate-400 uppercase font-bold tracking-wider">Score Final</p>
          <p class="text-5xl font-black text-blue-600 mt-2">${score} <span class="text-2xl text-slate-300">/ ${maxScore}</span></p>
        </div>

        <button onclick="location.reload()" class="w-full bg-slate-900 text-white font-bold py-4 rounded-xl active:scale-95 transition-transform shadow-xl">
          Recommencer
        </button>
      </div>
    `;

                if (progressBar) progressBar.style.width = "100%";
                if (progressText) progressText.textContent = "Terminé";
            }

            // ============================================================
            // 4. DÉMARRAGE
            // ============================================================
            if (allMots && allMots.length > 0) {
                renderLesson();
            } else {
                if (container) {
                    container.innerHTML = `
        <div class="text-center text-slate-500 p-8">
          <p class="text-xl font-bold mb-2">Aucun mot trouvé</p>
          <p>Le pack est vide ou introuvable.</p>
          <button onclick="location.back()" class="mt-6 text-blue-600 font-semibold underline">Retour</button>
        </div>
      `;
                }
            }
        </script>
    </body>
</html>
