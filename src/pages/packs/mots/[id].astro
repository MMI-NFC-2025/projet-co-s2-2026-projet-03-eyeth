---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import CardMot from "../../../components/CardMot.astro";

import { onePack } from "../../../js/backend.js";
import { getMotsForPack } from "../../../js/backend.js";

const { id } = Astro.params;
const pack = await onePack(id);
const mots = await getMotsForPack(id);
if (!pack) {
    return Astro.redirect("/packs");
}
---

<Layout titre={pack.nomPack}>
    <Hero title={pack.nomPack} retour="/packs/" />
    <a
        href={`/packs/lecon/${id}`}
        class="bg-bleu text-beige text-2xl rounded-lg flex items-center justify-center w-65 h-15 mx-auto"
        >Commencez la leçon</a
    >
    <div class="grid grid-cols-2 gap-6 max-w-4xl mx-auto p-4">
        {mots.map((mot) => <CardMot mot={mot} />)}
    </div>
    <a
        href={`/packs/lecon/${id}`}
        class="bg-bleu text-beige text-2xl rounded-lg flex items-center justify-center w-65 h-15 mx-auto mb-10"
        >Commencez la leçon</a
    >
</Layout>
