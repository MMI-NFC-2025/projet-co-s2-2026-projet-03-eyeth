---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import CardMot from "../../components/CardMot.astro";

import { getMots } from "../../js/backend.js";

const mots = await getMots();
---

<Layout titre="Dictionnaire">
    <Hero title="Dictionnaire" />
    <div class="grid grid-cols-2 gap-6 max-w-4xl mx-auto p-4">
        {mots.map((mot) => <CardMot mot={mot} />)}
    </div>
</Layout>
