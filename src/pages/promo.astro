---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getPacks } from "../js/backend.js";

const packs = ((await getPacks()) as any[]).slice(0, 3);

const benefits = [
	{
		title: "Apprentissage visuel",
		text: "Des repères clairs pour retenir plus vite les signes et revoir les bases à son rythme.",
	},
	{
		title: "Progression guidée",
		text: "Des packs et des leçons pour avancer étape par étape sans perdre la logique du parcours.",
	},
	{
		title: "Jeu et pratique",
		text: "Des jeux pour consolider les acquis et garder une dynamique régulière d'entraînement.",
	},
];

const steps = [
	"Choisissez un mot, un pack ou un jeu selon votre objectif du moment.",
	"Suivez une progression simple avec des contenus courts et accessibles.",
	"Revenez pratiquer pour mémoriser les signes dans la durée.",
];

const faqItems = [
	{
		question: "À qui s'adresse EYETH ?",
		answer:
			"EYETH s'adresse aux débutants curieux, aux personnes qui veulent réviser la LSF et à celles qui cherchent un apprentissage plus accessible.",
	},
	{
		question: "Faut-il déjà connaître la langue des signes ?",
		answer:
			"Non. La plateforme accompagne les premiers pas comme les révisions plus ciblées.",
	},
	{
		question: "Peut-on apprendre à son rythme ?",
		answer:
			"Oui. Les packs, le dictionnaire et les jeux permettent d'avancer selon son temps disponible.",
	},
];

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "EYETH",
	description:
		"Plateforme d'apprentissage de la langue des signes française avec jeux, packs et dictionnaire.",
	url: `${Astro.url.origin}/promo/`,
};

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqItems.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer,
		},
	})),
};
---

<Layout
	title="EYETH - Apprendre la LSF en jouant"
	description="Découvrez EYETH, la webapp pour apprendre la langue des signes française avec des packs, un dictionnaire visuel et des jeux interactifs."
	canonical="/promo/"
>
	<Hero title="Apprendre la LSF autrement" hideButton="true" />

	<section class="m-7 mt-0 text-center">
		<p class="mx-auto max-w-3xl text-lg">
			EYETH réunit des jeux, des packs et un dictionnaire visuel pour créer un
			apprentissage simple, structuré et motivant.
		</p>
		<nav class="flex flex-wrap justify-center gap-3 mt-8">
			<a href="/inscription" class="p-2 text-lg text-beige bg-bleu rounded inline-flex">
				Commencer gratuitement
			</a>
			<a href="/packs/" class="p-2 text-lg text-beige bg-rouge rounded inline-flex">
				Voir les packs
			</a>
		</nav>
	</section>

	<section class="my-10">
		<div class="w-screen relative left-1/2 right-1/2 ml-[-50vw] mr-[-50vw] bg-rouge py-4 px-7 text-beige">
			<h2 class="m-0 bg-transparent p-0 text-center">Pourquoi EYETH ?</h2>
		</div>
		<div class="m-7 mt-5 grid gap-5 md:grid-cols-3">
			{benefits.map((benefit, index) => (
				<article class="rounded-2xl border border-bleu/10 bg-white p-5 shadow-sm">
					<div class="mb-4 flex items-center justify-between">
						<div class="flex h-10 w-10 items-center justify-center rounded-full bg-rouge text-beige font-bold">0{index + 1}</div>
						<span class="text-sm uppercase tracking-[0.18em] text-rouge">{index === 0 ? "Découverte" : index === 1 ? "Progression" : "Motivation"}</span>
					</div>
					<div class="font-semibold text-xl mb-3">{benefit.title}</div>
					<p>{benefit.text}</p>
				</article>
			))}
		</div>
	</section>

	<section class="m-7">
		<h2 class="my-3">Comment ça marche</h2>
		<ol class="space-y-4 pl-0">
			{steps.map((step, index) => (
				<li class="flex gap-4 rounded-2xl border border-bleu/10 bg-beige p-4 shadow-sm">
					<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-bleu text-beige font-bold">{index + 1}</div>
					<p class="pt-1">{step}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="my-10">
		<div class="w-screen relative left-1/2 right-1/2 ml-[-50vw] mr-[-50vw] bg-rouge py-4 px-7 text-beige">
			<h2 class="m-0 bg-transparent p-0 text-center">Packs à découvrir</h2>
		</div>
		<div class="m-7 mt-5 grid gap-5 md:grid-cols-[1.2fr_0.8fr]">
			<div class="rounded-2xl border border-bleu/10 bg-white p-5 shadow-sm">
				<p class="mb-5">
					Les packs regroupent les contenus par thème pour garder une progression
					claire.
				</p>
				<ul class="space-y-3">
					{packs.map((pack: any) => (
						<li>
							<a href={`/packs/mots/${pack.id}`} class="block rounded-xl border border-bleu/10 bg-beige px-4 py-3 font-semibold transition-colors hover:bg-white">
								{pack.nomPack}
							</a>
						</li>
					))}
				</ul>
			</div>
			<div class="rounded-2xl bg-bleu p-5 text-beige shadow-lg">
				<p class="text-sm uppercase tracking-[0.18em] text-beige/75">Focus</p>
				<p class="mt-3 text-2xl font-bold leading-tight">
					Un apprentissage plus net, plus rythmé et plus facile à reprendre.
				</p>
				<p class="mt-4 text-beige/85">
					Chaque pack peut devenir une porte d'entrée vers un vocabulaire précis,
					puis vers les jeux pour consolider.
				</p>
				<p class="mt-6">
					<a href="/packs/" class="p-2 text-lg text-beige bg-rouge rounded inline-flex">
						Tous les packs
					</a>
				</p>
			</div>
		</div>
	</section>

	<section class="m-7">
		<div class="w-screen relative left-1/2 right-1/2 ml-[-50vw] mr-[-50vw] bg-rouge py-4 px-7 text-beige">
			<h2 class="m-0 bg-transparent p-0 text-center">Questions fréquentes</h2>
		</div>
		<div class="mt-5 space-y-4">
			{faqItems.map((item) => (
				<details class="rounded-2xl border border-bleu/10 bg-white p-4 shadow-sm">
					<summary class="cursor-pointer font-semibold">{item.question}</summary>
					<p class="mt-2">{item.answer}</p>
				</details>
			))}
		</div>
	</section>

	<section class="my-10 mb-10">
		<div class="w-screen relative left-1/2 right-1/2 ml-[-50vw] mr-[-50vw] bg-rouge py-4 px-7 text-beige">
			<h2 class="m-0 bg-transparent p-0 text-center">Prêt à commencer ?</h2>
		</div>
		<div class="m-7 mt-5 rounded-2xl border border-bleu/10 bg-beige p-6 text-center shadow-sm">
			<p class="mb-5 mx-auto max-w-3xl">
				Créez votre compte pour explorer EYETH, essayer les contenus et progresser
				à votre rythme.
			</p>
			<nav class="flex flex-wrap justify-center gap-3">
				<a href="/inscription" class="p-2 text-lg text-beige bg-bleu rounded inline-flex">
					Créer un compte
				</a>
				<a href="/connexion" class="p-2 text-lg text-beige bg-rouge rounded inline-flex">
					Se connecter
				</a>
			</nav>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify([websiteSchema, faqSchema])}></script>
</Layout>
