---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import CardFonctionnalite from "../components/CardBleu.astro";
import CardPack from "../components/CardPack.astro";

import placeHolderFonctionnalites from "../assets/placeHolderFonctionnalites.webp";
import placeHolderPack from "../assets/placeHolderJeux.webp";
import flechesGauche from "../assets/button_lightLeft.svg";
import flechesDroite from "../assets/button_lightRight.svg";

const items = [
    { nom: 'Pack "Démarrage"', description: "L'alphabet et les bases.", image: placeHolderPack, href: "/packs/demarrage" },
    { nom: 'Pack "Conversation"', description: "Scénarios du quotidien.", image: placeHolderPack, href: "/packs/conversation" },
    { nom: 'Pack "Expert"', description: "Concepts professionnels.", image: placeHolderPack, href: "/packs/expert" },
    { nom: 'Pack "Culture"', description: "Histoire et culture sourde.", image: placeHolderPack, href: "/packs/culture" },
];
---

<Layout title="eyeth">
    <Hero title="La langue des signes" />

    <div class="m-7">
        <h3 class="font-semibold text-xl">Qu'est-ce que EYETH ?</h3>
        <p class="mb-4">
            Bienvenue sur EYETH, la plateforme qui rend l'apprentissage de la LSF simple et visuel.
        </p>
        <nav class="flex justify-center m-5">
            <a href="/" class="p-2 text-lg text-beige bg-bleu hover:bg-rouge transition-colors duration-200 rounded inline-flex">
                En savoir plus
            </a>
        </nav>
    </div>

    <div class="text-beige mb-10">
        <h2 class="text-2xl font-bold mb-4">Nos fonctionnalités</h2>
        <CardFonctionnalite titre="Jeux" description="Les jeux se jouent seuls ou à plusieurs" image={placeHolderFonctionnalites} href="/jeux"/>
        <CardFonctionnalite titre="Leçons" description="Des parcours structurés" image={placeHolderFonctionnalites} />
        <CardFonctionnalite titre="Dictionnaire" description="Des milliers de signes" image={placeHolderFonctionnalites} />
    </div>

    <div class="mt-10 relative items-center">
        <h2 class="text-2xl font-bold mb-4">Apprenez par pack</h2>
        <p class="my-5 mx-10">
            Nos leçons peuvent être données sous forme de packs pour un apprentissage précis.
        </p>

        <div 
            id="carousel-packs"
            class="flex overflow-x-auto snap-x snap-mandatory gap-6 px-4 pb-4 scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        >
            {items.map((item) => (
                <!-- 
                  Simple div wrapper. 
                  Plus de 'group' car les flèches sont dehors.
                  Plus de lien <a> autour car CardPack gère le clic.
                -->
                <div class="snap-center shrink-0 min-w-[85%] md:min-w-100">
                    <CardPack
                        nom={item.nom}
                        description={item.description}
                        image={item.image}
                        href={item.href}
                    />
                </div>
            ))}
        </div>

        <div class="flex justify-center items-center gap-8 mb-10">
            
            <button 
                id="btn-prev"
                class="rounded-full hover:bg-bleu/40 transition-colors duration-200 focus:outline-none"
                aria-label="Voir les packs précédents"
            >
                <img src={flechesGauche.src} alt="Précédent" class="w-8 h-8 object-contain drop-shadow-md" />
            </button>

            <button 
                id="btn-next"
                class="rounded-full hover:bg-bleu/40 transition-colors duration-200 focus:outline-none"
                aria-label="Voir les packs suivants"
            >
                <img src={flechesDroite.src} alt="Suivant" class="w-8 h-8 object-contain " />
            </button>
        </div>
    </div>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const carousel = document.getElementById('carousel-packs');
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');

        if (carousel && btnPrev && btnNext) {
            const scrollAmount = 400;

            btnPrev.addEventListener('click', () => {
                carousel.scrollBy({
                    left: -scrollAmount,
                    behavior: 'smooth'
                });
            });

            btnNext.addEventListener('click', () => {
                carousel.scrollBy({
                    left: scrollAmount,
                    behavior: 'smooth'
                });
            });
            
        }
    });
</script>