---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import placeHolder from "../assets/placeHolderJeuxCarrousel.svg";
import flechesGauche from "../assets/button_lightLeft.svg";
import flechesDroite from "../assets/button_lightRight.svg";

const elements = [
    {
        nom: "Jeux du Mémory",
        description:
            "Découvrez notre jeu du Memory dédié à l'apprentissage de la LSF conçu pour apprendre en s'amusant. Associez les cartes pour relier un signe au mot correspondant. Renforcez votre mémoire visuelle et enrichissez progressivement votre vocabulaire en LSF",
        image: placeHolder,
    },
    {
        nom: "Undercover",
        description:
            "Découvrez notre jeu du Memory dédié à l'apprentissage de la LSF conçu pour apprendre en s'amusant. Associez les cartes pour relier un signe au mot correspondant. Renforcez votre mémoire visuelle et enrichissez progressivement votre vocabulaire en LSF",
        image: placeHolder,
    },
    {
        nom: "Mots-mêlés",
        description:
            "Découvrez notre jeu du Memory dédié à l'apprentissage de la LSF conçu pour apprendre en s'amusant. Associez les cartes pour relier un signe au mot correspondant. Renforcez votre mémoire visuelle et enrichissez progressivement votre vocabulaire en LSF",
        image: placeHolder,
    },
];
---

<Layout title="jeux" hideFooter="true">
    <div
        class="relative h-[calc(100dvh-4.6875rem)] w-full max-w-5xl aspect-video bg-beige overflow-hidden group"
    >
        <div class="relative items-center h-full flex flex-col">
            <div
                id="carousel-jeux"
                class="flex overflow-x-auto snap-x snap-mandatory gap-6 px-4 scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden w-full"
            >
                {
                    elements.map((item) => (
                        <div class="w-full shrink-0 snap-center m-3">
                            <a
                                href="/"
                                class="font-semibold text-xl hover:text-rouge"
                            >
                                {item.nom}
                            </a>
                            <p class="my-1">{item.description}</p>

                            <Image
                                src={item.image}
                                alt="Image d'illustration"
                                class="w-auto mx-auto h-45 object-cover"
                            />
                        </div>
                    ))
                }
            </div>

            <div class="flex gap-8 m-3">
                <button
                    id="btn-prev"
                    class="rounded-full hover:bg-bleu/40 transition-colors duration-200 focus:outline-none"
                    aria-label="Voir les jeux précédents"
                >
                    <Image
                        src={flechesGauche}
                        alt="Précédent"
                        class="w-8 h-8 object-contain drop-shadow-md"
                    />
                </button>

                <button
                    id="btn-next"
                    class="rounded-full hover:bg-bleu/40 transition-colors duration-200 focus:outline-none"
                    aria-label="Voir les jeux suivants"
                >
                    <Image
                        src={flechesDroite}
                        alt="Suivant"
                        class="w-8 h-8 object-contain"
                    />
                </button>
            </div>
        </div>
    </div>
</Layout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const carousel = document.getElementById("carousel-jeux");
        const btnPrev = document.getElementById("btn-prev");
        const btnNext = document.getElementById("btn-next");

        if (carousel && btnPrev && btnNext) {
            const scrollAmount = 400;

            btnPrev.addEventListener("click", () => {
                carousel.scrollBy({
                    left: -scrollAmount,
                    behavior: "smooth",
                });
            });

            btnNext.addEventListener("click", () => {
                carousel.scrollBy({
                    left: scrollAmount,
                    behavior: "smooth",
                });
            });
        }
    });
</script>
