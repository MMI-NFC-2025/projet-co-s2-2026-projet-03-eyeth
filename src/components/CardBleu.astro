---
import { Image } from "astro:assets";
const { titre, description, image, href = "/" } = Astro.props;
---

<a
    class="rounded-lg flex flex-col bg-bleu p-5 m-10 items-center text-beige"
    href={href}
>
    <Image
        class="rounded-lg w-full h-auto object-cover"
        src={image}
        alt="Image d'illustration pour {titre}"
    />

    <div class="text-xl font-semibold w-full mt-4">{titre}</div>
    <p class="mt-2 opacity-90">{description}</p>
</a>
