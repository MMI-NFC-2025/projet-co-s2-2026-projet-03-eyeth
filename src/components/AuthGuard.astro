---
export interface Props {
    redirectTo?: string;
}
const { redirectTo = "/login" } = Astro.props;
---

<script define:vars={{ redirectTo }}>
    import("/src/js/auth.js").then(({ isLoggedIn }) => {
        if (!isLoggedIn()) {
            window.location.href = redirectTo;
        }
    });
</script>
