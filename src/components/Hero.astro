---
import "../styles/global.css";
import { Image } from "astro:assets";
import backHero from "../assets/hero.webp";
import lightArrow from "../assets/arrow_beige.svg";
import darkArrow from "../assets/arrow_bleue.svg";

const {
    title = "",
    hideImage = false,
    hideButton = false,
    retour = "/",
} = Astro.props;
---

{
    !hideImage ? (
        <div class="relative flex items-center h-80 w-full overflow-hidden">
            <Image
                src={backHero}
                alt="Fond du hero"
                class="absolute inset-0 w-screen -z-10 max-h-130"
            />

            {!hideButton && (
                <a href={retour} class="absolute top-3 left-5 z-20">
                    <Image
                        src={lightArrow}
                        alt="Retour"
                        class="w-5 scale-x-[-1]"
                    />
                </a>
            )}
            <div class="relative flex items-center justify-center text-6xl text-beige   text-center mx-auto">
                <h1 class="flex">{title}</h1>
            </div>
        </div>
    ) : (
        <div class="relative flex flex-col items-center w-full py-5">
            {!hideButton && (
                <a href={retour} class="absolute top-0 left-5 z-20">
                    <Image
                        src={darkArrow}
                        alt="Retour"
                        class="h-10 w-auto scale-x-[-1]"
                    />
                </a>
            )}
        </div>
    )
}
