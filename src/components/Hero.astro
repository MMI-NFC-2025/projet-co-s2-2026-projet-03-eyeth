---
import "../styles/global.css";
import { Image } from "astro:assets";
import backHero from "../assets/hero.webp";
import lightArrow from "../assets/arrow_beige.svg";
import darkArrow from "../assets/arrow_bleue.svg";

const { title = "", hideImage = false, hideButton = false } = Astro.props;
---

{
    !hideImage ? (
        <div class="relative flex items-center h-75 w-full overflow-hidden">
            <Image
                src={backHero}
                alt="Fond du hero"
                class="absolute inset-0 w-full h-full object-cover -z-10"
            />

            {!hideButton && (
                <a
                    href="/"
                    class="absolute top-24 left-5 z-20 hover:opacity-80 transition-opacity"
                >
                    <Image
                        src={lightArrow}
                        alt="Retour"
                        class="w-5 scale-x-[-1]"
                    />
                </a>
            )}

            <h1 class="relative w-full text-center text-6xl text-beige px-12 mb-5 font-bold">
                {title}
            </h1>
        </div>
    ) : (
        <div class="relative flex flex-col items-center w-full py-3">
            {!hideButton && (
                <a
                    href="/"
                    class="absolute top-0 left-5 z-20 hover:opacity-80 transition-opacity"
                >
                    <Image
                        src={darkArrow}
                        alt="Retour"
                        class="w-5 scale-x-[-1]"
                    />
                </a>
            )}
        </div>
    )
}
