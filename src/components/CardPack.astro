---
import ImagePb from "../components/ImagePb.astro";
const { pack, classImg } = Astro.props;
---

<a href={`/packs/${pack.id}`} class={classImg}>
    {
        pack.illustration && (
            <ImagePb
                record={pack}
                field="illustration"
                classImg="absolute inset-0 z-0 w-full h-full object-cover"
            />
        )
    }

    <div class="absolute inset-0 z-10 bg-linear-to-t from-rouge to-transparent">
    </div>

    <div class="relative z-20 flex h-full flex-col justify-end p-6 text-beige">
        <h3 class="text-2xl font-bold mb-2 drop-shadow-md">
            {pack.nomPack}
        </h3>
    </div>
</a>
