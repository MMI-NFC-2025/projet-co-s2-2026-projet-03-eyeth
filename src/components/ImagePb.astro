---
import { pb } from "../js/backend.js";

const {
    record,
    field = "photo",
    alt,
    classImg,
    size = "1600x400",
} = Astro.props;

const imageUrl = record?.[field]
    ? pb.files.getURL(record, record[field], { thumb: size })
    : null;
---

{
    imageUrl ? (
        <img
            src={imageUrl}
            alt={alt || field.mot}
            class={classImg}
            loading="lazy"
            width="400"
            height="400"
        />
    ) : (
        <div
            class={`${classImg} bg-gray-500 flex items-center justify-center text-white`}
        >
            Pas d'image
        </div>
    )
}
