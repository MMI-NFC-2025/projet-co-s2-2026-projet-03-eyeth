---
import { getMotsAleatoires, pb } from "../js/backend.js";
import { Image } from "astro:assets";
import logo from "../assets/eyethRouge.svg";

const selection = await getMotsAleatoires(3);

const motsSerialized = JSON.stringify(
    selection.map((m) => ({
        ...m,
        // On garde l'URL de l'illustration principale
        illustrationUrl: m.illustration
            ? pb.files.getURL(m, m.illustration, { thumb: "400x400" })
            : null,
        // On prépare aussi l'URL de secours (champ 'illu' comme dans ImagePb)
        illuUrl: m.illu
            ? pb.files.getURL(m, m.illu, { thumb: "400x400" })
            : null,
    })),
);

const logoUrl = logo.src;
---

<div
    id="memory-root"
    class="w-full px-1 py-6"
    data-mots={motsSerialized}
    data-logo={logoUrl}
>
    <div class="flex items-center justify-between mb-5">
        <p class="text-sm text-bleu">
            Paires trouvées :
            <span id="score" class="font-semibold text-bleu">0</span>
            /
            <span id="total" class="font-semibold text-bleu dark:text-bleu"
                >3</span
            >
        </p>
        <button
            id="btn-restart"
            class="text-xs px-3 py-1.5 rounded-lg border border-rouge
             text-beige bg-bleu"
        >
            ↻ Recommencer
        </button>
    </div>

    <div
        id="error-msg"
        class="hidden p-3 text-sm text-red-700 bg-red-50 rounded-xl border border-red-200"
    >
    </div>

    <div id="grid" class="grid grid-cols-3 gap-3"></div>

    <div
        id="win-banner"
        class="hidden mt-5 text-center py-6 px-4 rounded-2xl
           bg-emerald-50 border border-emerald-200"
    >
        <p class="text-xl font-medium text-emerald-800">Bravo ! 🎉</p>
        <p id="win-msg" class="text-sm text-emerald-600"></p>
    </div>
</div>

<script>
    const CARD_BG = "bg-bleu dark:bg-bleu";
    const DOT_BG = "bg-white/20";

    interface Mot {
        mot: string;
        video: string | null;
        illu: string | null; // Le champ pour l'image de secours
        illustration: string | null;
        illustrationUrl: string | null;
        illuUrl: string | null; // L'URL générée pour le champ illu
    }

    interface Card {
        id: string;
        pairId: number;
        type: "word" | "illus";
        content: string;
        logoUrl: string;
        fallbackUrl: string | null; // URL de l'image 'illu' pour le fallback
    }

    let flipped: { el: HTMLElement; card: Card }[] = [];
    let matched = 0;
    let locked = false;
    let moves = 0;
    let allCards: Card[] = [];

    function shuffle<T>(arr: T[]): T[] {
        const a = [...arr];
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
    }

    function buildCards(paires: Mot[], logoUrl: string): Card[] {
        const cards: Card[] = [];
        paires.forEach((p, i) => {
            cards.push({
                id: `w${i}`,
                pairId: i,
                type: "word",
                content: p.mot,
                logoUrl,
                fallbackUrl: p.illuUrl, // On passe l'URL de secours
            });
            cards.push({
                id: `i${i}`,
                pairId: i,
                type: "illus",
                content: p.illustrationUrl ?? "",
                logoUrl,
                fallbackUrl: p.illuUrl,
            });
        });
        return shuffle(cards);
    }

    function renderGrid(cards: Card[]) {
        const grid = document.getElementById("grid")!;
        grid.innerHTML = "";
        allCards = cards;

        cards.forEach((c) => {
            const el = document.createElement("div");
            el.className = "card aspect-square cursor-pointer";
            el.style.perspective = "1000px";
            el.dataset.id = c.id;
            el.dataset.pair = String(c.pairId);

            const inner = document.createElement("div");
            inner.className = "card-inner";
            inner.style.transformStyle = "preserve-3d";
            inner.style.transition =
                "transform 0.6s cubic-bezier(0.4, 0.0, 0.2, 1)";
            inner.style.position = "relative";
            inner.style.width = "100%";
            inner.style.height = "100%";
            inner.style.transform = "rotateY(0deg)";

            // ── FACE (Contenu : Mot/Image) ──
            const front = document.createElement("div");
            front.className =
                "card-face rounded-2xl border border-gray-100 dark:border-gray-700 bg-white dark:bg-gray-900 flex items-center justify-center overflow-hidden";
            front.style.backfaceVisibility = "hidden";
            front.style.transform = "rotateY(180deg)";
            front.style.position = "absolute";
            front.style.width = "100%";
            front.style.height = "100%";
            front.style.borderRadius = "1rem";
            front.style.display = "flex";
            front.style.alignItems = "center";
            front.style.justifyContent = "center";
            front.style.zIndex = "1";

            if (c.type === "word") {
                const span = document.createElement("span");
                span.className = `text-center font-semibold px-2 leading-snug text-gray-800 dark:text-gray-100 ${c.content.length > 10 ? "text-sm" : "text-lg"}`;
                span.textContent = c.content;
                front.appendChild(span);
            } else {
                // Création de l'image principale
                const img = document.createElement("img");
                img.src = c.content;
                img.alt = "illustration";
                img.className = "w-full h-full object-cover";
                img.loading = "lazy";

                // GESTION DE L'ERREUR : Remplacement par l'image 'illu' (comme ImagePb)
                img.onerror = () => {
                    img.remove(); // On retire l'image cassée

                    if (c.fallbackUrl) {
                        // Si on a une URL dans le champ 'illu', on l'affiche
                        const fallbackImg = document.createElement("img");
                        fallbackImg.src = c.fallbackUrl;
                        fallbackImg.alt = "illustration secondaire";
                        fallbackImg.className = "w-full h-full object-cover";
                        fallbackImg.loading = "lazy";

                        // Gestion d'erreur sur le fallback aussi (au cas où)
                        fallbackImg.onerror = () => {
                            fallbackImg.remove();
                            // Dernier recours : un texte ou une icône discrète si rien ne marche
                            const span = document.createElement("span");
                            span.className =
                                "text-xs text-gray-400 text-center px-2";
                            span.textContent = "Image indisponible";
                            front.appendChild(span);
                        };
                        front.appendChild(fallbackImg);
                    } else {
                        // Si pas de fallback, on affiche un message
                        const span = document.createElement("span");
                        span.className =
                            "text-xs text-gray-400 text-center px-2";
                        span.textContent = "Pas d'image";
                        front.appendChild(span);
                    }
                };
                front.appendChild(img);
            }

            // ── DOS (Logo) ──
            const back = document.createElement("div");
            back.className = `card-face rounded-2xl border border-white/10 flex flex-col items-center justify-center gap-2 ${CARD_BG}`;
            back.style.backfaceVisibility = "hidden";
            back.style.transform = "rotateY(0deg)";
            back.style.position = "absolute";
            back.style.width = "100%";
            back.style.height = "100%";
            back.style.borderRadius = "1rem";
            back.style.display = "flex";
            back.style.alignItems = "center";
            back.style.justifyContent = "center";
            back.style.zIndex = "2";

            const imgContainer = document.createElement("div");
            imgContainer.className = `w-1/2 h-1/2 flex items-center justify-center ${DOT_BG} rounded-full p-3`;

            const logoImg = document.createElement("img");
            logoImg.src = c.logoUrl;
            logoImg.alt = "Logo";
            logoImg.className = "w-full h-full object-contain";

            imgContainer.appendChild(logoImg);
            back.appendChild(imgContainer);

            inner.appendChild(front);
            inner.appendChild(back);

            el.appendChild(inner);

            el.addEventListener("click", () => onCardClick(el, c));
            grid.appendChild(el);
        });
    }

    function onCardClick(el: HTMLElement, card: Card) {
        if (locked) return;
        if (
            el.classList.contains("flipped") ||
            el.classList.contains("matched")
        )
            return;

        el.classList.add("flipped");

        const inner = el.querySelector(".card-inner") as HTMLElement;
        if (inner) {
            inner.style.transform = "rotateY(180deg)";
        }

        flipped.push({ el, card });

        if (flipped.length === 2) {
            locked = true;
            moves++;
            checkMatch();
        }
    }

    function checkMatch() {
        const [a, b] = flipped;
        const isMatch =
            a.card.pairId === b.card.pairId && a.card.type !== b.card.type;

        if (isMatch) {
            a.el.classList.add("matched");
            b.el.classList.add("matched");

            [a.el, b.el].forEach((el) => {
                const faceContent = el.querySelector(".card-inner")
                    ?.children[0] as HTMLElement;
                if (faceContent) {
                    faceContent.style.borderColor = "#34d399";
                    faceContent.style.boxShadow = "0 0 0 2px #34d399";
                }
            });
            matched++;
            document.getElementById("score")!.textContent = String(matched);
            flipped = [];
            locked = false;
            if (matched === allCards.length / 2) showWin();
        } else {
            setTimeout(() => {
                const innerA = a.el.querySelector(".card-inner") as HTMLElement;
                const innerB = b.el.querySelector(".card-inner") as HTMLElement;

                if (innerA) innerA.style.transform = "rotateY(0deg)";
                if (innerB) innerB.style.transform = "rotateY(0deg)";

                a.el.classList.remove("flipped");
                b.el.classList.remove("flipped");
                flipped = [];
                locked = false;
            }, 1000);
        }
    }

    function showWin() {
        const banner = document.getElementById("win-banner")!;
        banner.classList.remove("hidden");
        document.getElementById("win-msg")!.textContent =
            `Toutes les paires trouvées en ${moves} tentative${moves > 1 ? "s" : ""} !`;
    }

    function showError(msg: string) {
        const el = document.getElementById("error-msg")!;
        el.textContent = msg;
        el.classList.remove("hidden");
    }

    function init() {
        const root = document.getElementById("memory-root")!;
        const raw = root.dataset.mots ?? "[]";
        const logoUrl = root.dataset.logo ?? "";

        let mots: Mot[] = [];
        try {
            mots = JSON.parse(raw);
        } catch {
            showError("Impossible de lire les données des mots.");
            return;
        }

        if (mots.length < 3) {
            showError(
                "Pas assez de mots avec illustration (minimum 3 requis).",
            );
            return;
        }

        flipped = [];
        matched = 0;
        locked = false;
        moves = 0;
        document.getElementById("score")!.textContent = "0";
        document.getElementById("total")!.textContent = String(mots.length);
        document.getElementById("win-banner")!.classList.add("hidden");
        document.getElementById("error-msg")!.classList.add("hidden");

        renderGrid(buildCards(mots, logoUrl));
    }

    document.getElementById("btn-restart")?.addEventListener("click", () => {
        window.location.reload();
    });

    init();
</script>

<style>
    .card {
        cursor: pointer;
    }
    .card-inner {
        transform-style: preserve-3d;
    }
</style>
