---
import { Image } from "astro:assets";
import background from "../assets/backimage_footer.svg";

const navLinks = [
    { label: "Nos jeux", href: "/jeux" },
    { label: "Nos Packs", href: "/packs/" },
    { label: "À propos", href: "/info" },
];
---

<footer class="flex relative overflow-hidden text-beige">
    <Image
        class="absolute z-1 object-cover object-top w-full col-span-2 bottom-0"
        src={background}
        alt="Fond du footer"
    />
    <div
        class="relative w-full box-border m-5 justify-center grid grid-cols-2 z-2 p-8 pr-0"
    >
        <nav class="flex max-w-75">
            <ul
                class="flex flex-col gap-5 list-none text-xl font-semibold u-list-unstyled"
            >
                {
                    navLinks.map((navLink) => (
                        <li>
                            <a href={navLink.href}>{navLink.label}</a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <nav class="flex flex-col gap-5 list-none font-normal u-list-unstyled">
            <ul>
                <li>
                    <a href="#"> Instragram </a>
                </li>
                <li>
                    <a href="https://portfolio.geiss-solene.fr/"> Behance </a>
                </li>
                <li><a href="https://lola-brouart.fr/">LinkedIn</a></li>
            </ul>
        </nav>
        <nav
            class="flex flex-col gap-5 list-none u-list-unstyled pt-10 col-span-2"
        >
            <ul>
                <li class="py-2">
                    <a href="+33 05 05 05 05 05 " class="font-normal">
                        +33 05 05 05 05 05
                    </a>
                </li>
                <li class="py-2">
                    <a href="eyeth@gmail.com" class="text-2xl font-medium">
                        eyeth@gmail.com
                    </a>
                </li>
                <li class="py-2">
                    <a href="/" class="font-normal">
                        4 pl Lucien Tharradin <br />
                        25200 Montbéliard
                    </a>
                </li>
            </ul>
        </nav>
        <nav
            class="col-span-2 grid grid-cols-subgrid grid-cols-2cols-2 pt-5 text-xs"
        >
            <a href="/cgu">Mentions légales</a>
            <a href="/politiqConf">Politique de confidentialité</a>
        </nav>
    </div>
</footer>
