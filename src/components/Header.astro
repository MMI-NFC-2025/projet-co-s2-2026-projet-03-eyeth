---
import "../styles/global.css";
import { Image } from "astro:assets";
import logoBleu from "../assets/eyethBleu.svg";
import logoBeige from "../assets/eyethBeige.svg";
import backMenu from "../assets/backimage_hero_menu.svg";
import bonhommeBleu from "../assets/bonhommeBleu.svg";

const navLinks = [
  { label: "Accueil", href: "/" },
  { label: "A propos", href: "/" },
  { label: "Services", href: "/" },
  { label: "Portfolio", href: "/" },
  { label: "Contact", href: "/" },
];
---

<header class="fixed top-0 left-0 right-0 z-50">
  <Image
    id="menu-bg"
    src={backMenu}
    alt="Fond du menu"
    aria-hidden="true"
    class="absolute inset-0 w-screen h-screen object-cover -z-10 opacity-0 transition-opacity duration-300"
  />
  <div id="header" class="flex items-center justify-between h-16 bg-beige">
    <a href="/">
      <Image
        src={logoBleu}
        alt="logoEyethBleu"
        class="h-12"
        id="logo"
        data-logo-header={logoBleu.src}
        data-logo-menu={logoBeige.src}
      />
    </a>
    <a id="bouton-connexion" href="/"
      ><Image src={bonhommeBleu} alt="Bouton de connexion" /></a
    >
    <button
      id="hamburger-btn"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden flex flex-col justify-center items-center w-screen h-screen gap-1.5"
    >
      <span
        id="bar-1"
        class="block w-6 h-0.5 bg-bleu rounded-full transition-all duration-300 origin-center"
      ></span>
      <span
        id="bar-2"
        class="block w-6 h-0.5 bg-bleu rounded-full transition-all duration-300"
      ></span>
      <span
        id="bar-3"
        class="block w-6 h-0.5 bg-bleu rounded-full transition-all duration-300 origin-center"
      ></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-hidden="true"
    class="overflow-hidden duration-300 ease-in-out"
  >
    <ul class="flex flex-col px-5 py-4 gap-1">
      {
        navLinks.map((link, i) => (
          <li>
            <a
              href={link.href}
              class="mobile-link flex items-center gap-3 px-3 py-3 text-beige hover:text-rouge font-medium text-base transition-colors duration-200 opacity-0 translate-y-2 "
              style={`transition-delay: ${i * 50}ms`}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<!-- Spacer pour compenser le header fixed -->
<div class="h-16"></div>

<script>
  const btn = document.getElementById("hamburger-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const bar1 = document.getElementById("bar-1")!;
  const bar2 = document.getElementById("bar-2")!;
  const bar3 = document.getElementById("bar-3")!;
  const links = document.querySelectorAll<HTMLElement>(".mobile-link");
  const logo = document.getElementById("logo") as HTMLImageElement;
  const LOGO_HEADER = logo.dataset.logoHeader!;
  const LOGO_MENU = logo.dataset.logoMenu!;
  const header = document.getElementById("header")!;
  const menuBg = document.getElementById("menu-bg")!;
  const boutonConnexion = document.getElementById("bouton-connexion")!;

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    btn.setAttribute("aria-expanded", "true");
    menu.setAttribute("aria-hidden", "false");

    menu.style.maxHeight = menu.scrollHeight + "px";

    logo.style.opacity = "0";
    setTimeout(() => {
      logo.src = LOGO_MENU;
      logo.style.opacity = "1";
    }, 150);

    bar1.style.transform = "translateY(8px) rotate(45deg)";
    bar2.style.opacity = "0";
    bar2.style.transform = "scaleX(0)";
    bar3.style.transform = "translateY(-8px) rotate(-45deg)";

    bar1.classList.replace("bg-bleu", "bg-beige");
    bar3.classList.replace("bg-bleu", "bg-beige");
    header.classList.remove("bg-beige");
    menuBg.classList.replace("opacity-0", "opacity-100");
    boutonConnexion.classList.add("opacity-0");

    links.forEach((link) => {
      link.style.opacity = "1";
      link.style.transform = "translateY(0)";
    });
  }

  function closeMenu() {
    isOpen = false;
    btn.setAttribute("aria-expanded", "false");
    menu.setAttribute("aria-hidden", "true");

    menu.style.maxHeight = "0";

    logo.style.opacity = "0";
    setTimeout(() => {
      logo.src = LOGO_HEADER;
      logo.style.opacity = "1";
    }, 150);

    bar1.style.transform = "";
    bar2.style.opacity = "";
    bar2.style.transform = "";
    bar3.style.transform = "";

    bar1.classList.replace("bg-beige", "bg-bleu");
    bar3.classList.replace("bg-beige", "bg-bleu");
    header.classList.add("bg-beige");
    menuBg.classList.replace("opacity-100", "opacity-0");
    boutonConnexion.classList.remove("opacity-0");

    links.forEach((link) => {
      link.style.opacity = "0";
      link.style.transform = "translateY(8px)";
    });
  }

  btn.addEventListener("click", () => {
    isOpen ? closeMenu() : openMenu();
  });

  links.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && isOpen) {
      closeMenu();
    }
  });
</script>
