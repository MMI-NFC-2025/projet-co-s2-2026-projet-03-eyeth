---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/eyethBleu.svg";

const navLinks = [
  { label: "Accueil", href: "/" },
  { label: "A propos", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Contact", href: "/contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-beige">
  <div class="flex items-center justify-between px-5 h-16">
    <a href="/">
      <Image src={logo} alt="logo" class="h-12" />
    </a>

    <button
      id="hamburger-btn"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5"
    >
      <span
        id="bar-1"
        class="block w-6 h-0.5 bg-bleu rounded-full transition-all duration-300 origin-center"
      ></span>
      <span
        id="bar-2"
        class="block w-6 h-0.5 bg-bleu rounded-full transition-all duration-300"
      ></span>
      <span
        id="bar-3"
        class="block w-6 h-0.5 bg-bleu rounded-full transition-all duration-300 origin-center"
      ></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-hidden="true"
    class="overflow-hidden max-h-0 duration-300 ease-in-out bg-beige"
  >
    <ul class="flex flex-col px-5 py-4 gap-1">
      {
        navLinks.map((link, i) => (
          <li>
            <a
              href={link.href}
              class="mobile-link flex items-center gap-3 px-3 py-3 text-bleu hover:text-rouge font-medium text-base transition-colors duration-200 opacity-0 translate-y-2"
              style={`transition-delay: ${i * 50}ms`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-rouge shrink-0" />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<!-- Spacer pour compenser le header fixed -->
<div class="h-16"></div>

<script>
  const btn = document.getElementById("hamburger-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const bar1 = document.getElementById("bar-1")!;
  const bar2 = document.getElementById("bar-2")!;
  const bar3 = document.getElementById("bar-3")!;
  const links = document.querySelectorAll<HTMLElement>(".mobile-link");

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    btn.setAttribute("aria-expanded", "true");
    menu.setAttribute("aria-hidden", "false");

    menu.style.maxHeight = menu.scrollHeight + "px";

    bar1.style.transform = "translateY(8px) rotate(45deg)";
    bar2.style.opacity = "0";
    bar2.style.transform = "scaleX(0)";
    bar3.style.transform = "translateY(-8px) rotate(-45deg)";

    links.forEach((link) => {
      link.style.opacity = "1";
      link.style.transform = "translateY(0)";
    });
  }

  function closeMenu() {
    isOpen = false;
    btn.setAttribute("aria-expanded", "false");
    menu.setAttribute("aria-hidden", "true");

    menu.style.maxHeight = "0";

    bar1.style.transform = "";
    bar2.style.opacity = "";
    bar2.style.transform = "";
    bar3.style.transform = "";

    links.forEach((link) => {
      link.style.opacity = "0";
      link.style.transform = "translateY(8px)";
    });
  }

  btn.addEventListener("click", () => {
    isOpen ? closeMenu() : openMenu();
  });

  links.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && isOpen) {
      closeMenu();
    }
  });
</script>
