  <nav>
    <ul>
      <li>
        <a class="block relative z-20" href="/">Home</a>
      </li>
      <li>
        <a class="block relative z-20" href="/portfolio.html">Portfolio</a>
      </li>
      <li>
        <a class="block relative z-20" href="/about.html">About us</a>
      </li>
      <li>
        <a class="block relative z-20" href="/contact.html">Contact</a>
      </li>
    </ul>
    <ul>
      <li>
        <a href="https://instagram.com">Instagram</a>
      </li>
      <li>
        <a href="https://www.behance.net/">Behance</a>
      </li>
      <li>
        <a href="https://www.linkedin.com/">LinkedIn</a>
      </li>
    </ul>
  </nav>
</header>

