---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/eyethBleu.svg";
---

<header
  class="bg-beige absolute left-0 w-full px-2xl py-4xl flex items-center justify-between"
>
  <a href="/">
    <Image alt="Logo eyeth" src={logo} class="h-12" />
  </a>
  <button class="relative w-4xl h-4xl flex justify-center items-center">
    <span> </span>
    <span> </span>
  </button>

