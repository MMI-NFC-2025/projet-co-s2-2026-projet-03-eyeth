---
import "../styles/global.css";
import UserMenu from "../components/UserMenu.astro";
import { Image } from "astro:assets";
import logoBleu from "../assets/eyethBleu.svg";
import logoBeige from "../assets/eyethBeige.svg";
import backMenu from "../assets/menu.webp";
import bonhommeBleu from "../assets/bonhommeBleu.svg";

const navLinks = [
  { label: "Jeux", href: "/jeux" },
  { label: "Nos Packs", href: "/packs/" },
  { label: "Dictionnaire", href: "/mots/" },
  { label: "À propos", href: "/info" },
  { label: "Contact", href: "/" },
];
---

<header class="fixed top-0 left-0 right-0 z-50">
  <Image
    id="menu-bg"
    src={backMenu}
    alt="Fond du menu"
    aria-hidden="true"
    class="absolute inset-0 w-full h-0 object-cover opacity-0 -z-10 transition-all duration-300 ease-in-out"
  />

  <div
    id="header"
    class="relative flex items-center justify-between h-18.75 bg-beige px-7.5 z-50 transition-colors duration-300"
  >
    <a href="/" class="relative z-50">
      <Image
        src={logoBleu}
        alt="logoEyethBleu"
        class="h-5.5 w-auto transition-opacity duration-300"
        id="logo"
        data-logo-header={logoBleu.src}
        data-logo-menu={logoBeige.src}
      />
    </a>
    <div class="flex items-center w-15.5 justify-between relative z-50">
      <a
        id="bouton-connexion"
        href="/connexion"
        class="transition-opacity duration-300"
      >
        <Image src={bonhommeBleu} alt="Bouton de connexion" />
      </a>
      <button
        id="hamburger-btn"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden flex flex-col justify-center items-center gap-1.5 relative z-50"
      >
        <span
          id="bar-1"
          class="block w-7.25 h-0.5 bg-bleu rounded-full transition-all duration-300 origin-center"
        ></span>
        <span
          id="bar-2"
          class="block w-7.25 h-0.5 bg-bleu rounded-full transition-all duration-300"
        ></span>
        <span
          id="bar-3"
          class="block w-7.25 h-0.5 bg-bleu rounded-full transition-all duration-300 origin-center"
        ></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-hidden="true"
    class="relative overflow-hidden h-0 w-full transition-all duration-300 ease-in-out z-40"
  >
    <div class="relative flex flex-col items-center">
      <span
        id="line1"
        class="block w-88.25 h-0.5 bg-beige rounded-full mx-auto opacity-0 transition-opacity duration-300 mb-4"
      ></span>

      <ul class="flex flex-col gap-2 w-full max-w-md py-2">
        {
          navLinks.map((link, i) => (
            <li>
              <a
                href={link.href}
                data-index={i}
                class="mobile-link px-3 py-2 text-xl text-beige  transition-all duration-300 ease-out opacity-0 translate-y-4 pointer-events-none inline-flex"
                style={`transition-delay: ${i * 50}ms`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <span
        id="line2"
        class="block w-88.25 h-px bg-beige rounded-full mx-auto opacity-0 transition-opacity duration-300 my-6"
      ></span>

      <ul class="flex flex-col gap-2 w-full max-w-md">
        <UserMenu />
        <li>
          <a
            href="/connexion"
            class="mobile-link block px-3 py-3 text-lg text-beige transition-all duration-300 ease-out opacity-0 translate-y-4 pointer-events-none"
            style={`transition-delay: ${250}ms`}
          >
            Connexion
          </a>
        </li>
        <li>
          <a
            href="/inscription"
            class="mobile-link block px-3 py-3 text-lg text-beige transition-all duration-300 ease-out opacity-0 translate-y-4 pointer-events-none"
            style={`transition-delay: ${300}ms`}
          >
            Inscription
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<div class="h-18.75"></div>

<script>
  const btn = document.getElementById("hamburger-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const bar1 = document.getElementById("bar-1")!;
  const bar2 = document.getElementById("bar-2")!;
  const bar3 = document.getElementById("bar-3")!;
  const links = document.querySelectorAll<HTMLElement>(".mobile-link");
  const logo = document.getElementById("logo") as HTMLImageElement;
  const LOGO_HEADER = logo.dataset.logoHeader!;
  const LOGO_MENU = logo.dataset.logoMenu!;
  const header = document.getElementById("header")!;
  const menuBg = document.getElementById("menu-bg")!;
  const boutonConnexion = document.getElementById("bouton-connexion")!;
  const line1 = document.getElementById("line1")!;
  const line2 = document.getElementById("line2")!;

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;

    if (isOpen) {
      btn.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-hidden", "false");

      menu.classList.remove("h-0");
      menu.classList.add("h-screen");

      menuBg.classList.remove("h-0", "opacity-0");
      menuBg.classList.add("h-screen", "opacity-100");

      header.classList.remove("bg-beige");
      logo.style.opacity = "0";
      setTimeout(() => {
        logo.src = LOGO_MENU;
        logo.style.opacity = "1";
      }, 150);

      bar1.classList.replace("bg-bleu", "bg-beige");
      bar3.classList.replace("bg-bleu", "bg-beige");
      bar1.style.transform = "translateY(8px) rotate(45deg)";
      bar2.style.opacity = "0";
      bar2.style.transform = "scaleX(0)";
      bar3.style.transform = "translateY(-8px) rotate(-45deg)";

      line1.classList.remove("opacity-0");
      line1.classList.add("opacity-10");
      line2.classList.remove("opacity-0");
      line2.classList.add("opacity-100");

      boutonConnexion.classList.add("opacity-0", "pointer-events-none");

      requestAnimationFrame(() => {
        links.forEach((link) => {
          link.classList.remove(
            "opacity-0",
            "translate-y-4",
            "pointer-events-none",
          );
          link.classList.add("opacity-100", "translate-y-0");
        });
      });

      const scrollbarWidth =
        window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = "hidden";
      document.body.style.paddingRight = `${scrollbarWidth}px`;
    } else {
      btn.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");

      links.forEach((link) => {
        link.classList.remove("opacity-100", "translate-y-0");
        link.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
      });

      menuBg.classList.remove("h-screen", "opacity-100");
      menuBg.classList.add("h-0", "opacity-0");

      setTimeout(() => {
        menu.classList.remove("h-screen");
        menu.classList.add("h-0");
      }, 100);

      header.classList.add("bg-beige");
      logo.style.opacity = "0";
      setTimeout(() => {
        logo.src = LOGO_HEADER;
        logo.style.opacity = "1";
      }, 150);

      bar1.classList.replace("bg-beige", "bg-bleu");
      bar3.classList.replace("bg-beige", "bg-bleu");
      bar1.style.transform = "";
      bar2.style.opacity = "1";
      bar2.style.transform = "";
      bar3.style.transform = "";

      line1.classList.remove("opacity-10");
      line1.classList.add("opacity-0");
      line2.classList.remove("opacity-100");
      line2.classList.add("opacity-0");

      boutonConnexion.classList.remove("opacity-0", "pointer-events-none");

      document.body.style.overflow = "";
      document.body.style.paddingRight = "";
    }
  }

  btn.addEventListener("click", toggleMenu);

  links.forEach((link) => {
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) toggleMenu();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && isOpen) toggleMenu();
  });
</script>
