---
import "../styles/global.css";
import { Image } from "astro:assets";
import logoBleu from "../assets/eyethBleu.svg";
import logoBeige from "../assets/eyethBeige.svg";
import backMenu from "../assets/backimage_hero_menu.svg";
import bonhommeBleu from "../assets/bonhommeBleu.svg";

const navLinks = [
  { label: "Accueil", href: "/" },
  { label: "A propos", href: "/" },
  { label: "Services", href: "/" },
  { label: "Portfolio", href: "/" },
  { label: "Contact", href: "/" },
];
---

<header class="fixed top-0 left-0 right-0 z-50">
  <Image
    id="menu-bg"
    src={backMenu}
    alt="Fond du menu"
    aria-hidden="true"
    class="absolute inset-0 w-screen h-screen object-cover -z-10 opacity-0 transition-opacity duration-300"
  />
  <div
    id="header"
    class="flex items-center justify-between h-18.75 bg-beige px-7.5"
  >
    <a href="/">
      <Image
        src={logoBleu}
        alt="logoEyethBleu"
        class="h-5.5 w-auto"
        id="logo"
        data-logo-header={logoBleu.src}
        data-logo-menu={logoBeige.src}
      />
    </a>
    <div class="flex items-center w-15.5 justify-between">
      <a id="bouton-connexion" href="/"
        ><Image src={bonhommeBleu} alt="Bouton de connexion" /></a
      >
      <button
        id="hamburger-btn"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden flex flex-col justify-center items-center gap-1.5"
      >
        <span
          id="bar-1"
          class="block w-7.25 h-0.5 bg-bleu rounded-full transition-all duration-300 origin-center"
        ></span>
        <span
          id="bar-2"
          class="block w-7.25 h-0.5 bg-bleu rounded-full transition-all duration-300"
        ></span>
        <span
          id="bar-3"
          class="block w-7.25 h-0.5 bg-bleu rounded-full transition-all duration-300 origin-center"
        ></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-hidden="true"
    class="overflow-hidden duration-300 ease-in-out"
  >
    <span
      id="line1"
      class="block w-88.25 h-0.5 top-18.75 bg-beige rounded-full mx-auto opacity-0 duration-300"
    ></span>
    <ul class="flex flex-col px-5 py-2 gap-1">
      <div>
        {
          navLinks.map((link, i) => (
            <li>
              <a
                href={link.href}
                class="mobile-link flex items-center gap-3 px-3 py-3 w-33.75 text-2xl   text-beige hover:text-rouge transition-colors duration-200 opacity-0 translate-y-2 "
                style={`transition-delay: ${i * 50}ms`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </div>
    </ul>
    <span
      id="line2"
      class="block w-88.25 h-px top-18.75 bg-beige rounded-full mx-auto duration-300 my-4 opacity-0"
    ></span>
    <ul class="flex flex-col px-5 py-4 gap-1">
      <li>
        <a
          href="/"
          class="mobile-link flex items-center gap-3 px-3 pb-3 w-33.75 text-2xl text-beige hover:text-rouge transition-colors duration-200 opacity-0 translate-y-2"
          style={`transition-delay: ${50}ms`}
        >
          Connexion
        </a>
      </li>
      <li>
        <a
          href="/"
          class="mobile-link flex items-center gap-3 px-3 pb-3 w-33.75 text-2xl text-beige hover:text-rouge transition-colors duration-200 opacity-0 translate-y-2"
          style={`transition-delay: ${50}ms`}
        >
          Inscription
        </a>
      </li>
    </ul>
  </nav>
</header>

<!-- Spacer pour compenser le header fixed -->
<div class="h-16"></div>

<script>
  const btn = document.getElementById("hamburger-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const bar1 = document.getElementById("bar-1")!;
  const bar2 = document.getElementById("bar-2")!;
  const bar3 = document.getElementById("bar-3")!;
  const links = document.querySelectorAll<HTMLElement>(".mobile-link");
  const logo = document.getElementById("logo") as HTMLImageElement;
  const LOGO_HEADER = logo.dataset.logoHeader!;
  const LOGO_MENU = logo.dataset.logoMenu!;
  const header = document.getElementById("header")!;
  const menuBg = document.getElementById("menu-bg")!;
  const boutonConnexion = document.getElementById("bouton-connexion")!;
  const line1 = document.getElementById("line1")!;
  const line2 = document.getElementById("line2")!;

  let isOpen = false;

  // --- FONCTIONS NO-SCROLL ---
  function lockScroll() {
    // Calcule la largeur de la scrollbar pour éviter le décalage du contenu
    const scrollbarWidth =
      window.innerWidth - document.documentElement.clientWidth;
    document.body.style.overflow = "hidden";
    document.body.style.paddingRight = `${scrollbarWidth}px`;
  }

  function unlockScroll() {
    document.body.style.overflow = "";
    document.body.style.paddingRight = "";
  }
  // ---------------------------

  function openMenu() {
    isOpen = true;
    btn.setAttribute("aria-expanded", "true");
    menu.setAttribute("aria-hidden", "false");

    // Activation du no-scroll
    lockScroll();

    menu.style.maxHeight = menu.scrollHeight + "px";

    logo.style.opacity = "0";
    setTimeout(() => {
      logo.src = LOGO_MENU;
      logo.style.opacity = "1";
    }, 150);

    bar1.style.transform = "translateY(8px) rotate(45deg)";
    bar2.style.opacity = "0";
    bar2.style.transform = "scaleX(0)";
    bar3.style.transform = "translateY(-8px) rotate(-45deg)";

    bar1.classList.replace("bg-bleu", "bg-beige");
    bar3.classList.replace("bg-bleu", "bg-beige");
    menuBg.classList.replace("opacity-0", "opacity-100");
    line1.classList.replace("opacity-0", "opacity-10");
    line2.classList.replace("opacity-0", "opacity-100");
    header.classList.remove("bg-beige");
    boutonConnexion.classList.add("opacity-0");

    links.forEach((link) => {
      link.style.opacity = "1";
      link.style.transform = "translateY(0)";
    });
  }

  function closeMenu() {
    isOpen = false;
    btn.setAttribute("aria-expanded", "false");
    menu.setAttribute("aria-hidden", "true");

    // Désactivation du no-scroll
    unlockScroll();

    menu.style.maxHeight = "0";

    logo.style.opacity = "0";
    setTimeout(() => {
      logo.src = LOGO_HEADER;
      logo.style.opacity = "1";
    }, 150);

    bar1.style.transform = "";
    bar2.style.opacity = "";
    bar2.style.transform = "";
    bar3.style.transform = "";

    bar1.classList.replace("bg-beige", "bg-bleu");
    bar3.classList.replace("bg-beige", "bg-bleu");
    menuBg.classList.replace("opacity-100", "opacity-0");
    line1.classList.replace("opacity-10", "opacity-0");
    line2.classList.replace("opacity-100", "opacity-0");
    header.classList.add("bg-beige");
    boutonConnexion.classList.remove("opacity-0");

    links.forEach((link) => {
      link.style.opacity = "0";
      link.style.transform = "translateY(8px)";
    });
  }

  btn.addEventListener("click", () => {
    isOpen ? closeMenu() : openMenu();
  });

  links.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Fermeture avec la touche Echap (Accessibilité)
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) {
      closeMenu();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && isOpen) {
      closeMenu();
    }
  });
</script>
